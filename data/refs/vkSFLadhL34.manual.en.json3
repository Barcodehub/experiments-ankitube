  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 731,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "(bright upbeat music)"
    } ]
  }, {
    "tStartMs": 2651,
    "dDurationMs": 1939,
    "segs": [ {
      "utf8": "[Adelynn] The YCC program is so broad"
    } ]
  }, {
    "tStartMs": 4590,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "that there's something for everyone."
    } ]
  }, {
    "tStartMs": 6390,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "[Esme] Everyone's starting\nfrom different places."
    } ]
  }, {
    "tStartMs": 8220,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "Some of us are runners, some\nof us have never been hiking."
    } ]
  }, {
    "tStartMs": 11550,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "No matter your skill level,\nyou're going to be welcomed."
    } ]
  }, {
    "tStartMs": 14130,
    "dDurationMs": 3543,
    "segs": [ {
      "utf8": "[Frank] It's really one of\nthe best jobs around here."
    } ]
  }, {
    "tStartMs": 20580,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "[Oden] A few weeks ago,"
    } ]
  }, {
    "tStartMs": 21630,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "we finished a really long\nsection of boardwalk."
    } ]
  }, {
    "tStartMs": 24780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "[Frank] It was really an exciting\ntime when we finished that"
    } ]
  }, {
    "tStartMs": 27270,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "because it was three years in the making."
    } ]
  }, {
    "tStartMs": 29160,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "[Oden] A lot of teamwork and cooperation."
    } ]
  }, {
    "tStartMs": 31470,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "It was a good day."
    } ]
  }, {
    "tStartMs": 32640,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "[Fiona] By building these rock walls,"
    } ]
  }, {
    "tStartMs": 34050,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "we're protecting the trail"
    } ]
  }, {
    "tStartMs": 35280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "from those falling\nrocks, from that erosion."
    } ]
  }, {
    "tStartMs": 37620,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "[Shasta] The rock walls last\nfor decades, potentially."
    } ]
  }, {
    "tStartMs": 41040,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It's really fulfilling"
    } ]
  }, {
    "tStartMs": 42120,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "to have tangible work that you can see"
    } ]
  }, {
    "tStartMs": 45810,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "and have something to look back on,"
    } ]
  }, {
    "tStartMs": 48180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that they're like, \"I did that.\""
    } ]
  }, {
    "tStartMs": 50100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "They learn about the multifaceted\njob pool of the park."
    } ]
  }, {
    "tStartMs": 54300,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "[Aiden] It allowed for us\nto get a lot of opportunity"
    } ]
  }, {
    "tStartMs": 56310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "to talk with an actual field researcher"
    } ]
  }, {
    "tStartMs": 58410,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "who explained why we're doing this,"
    } ]
  }, {
    "tStartMs": 60450,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "how we are actually contributing"
    } ]
  }, {
    "tStartMs": 61890,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to the scientific research\nthat's being done."
    } ]
  }, {
    "tStartMs": 64260,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "[Esme] We need to make sure"
    } ]
  }, {
    "tStartMs": 65093,
    "dDurationMs": 1777,
    "segs": [ {
      "utf8": "that we're listening to\neach other's concerns,"
    } ]
  }, {
    "tStartMs": 66870,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "we're looking out for each other."
    } ]
  }, {
    "tStartMs": 68250,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "[Noelani] Even if it seems overlooked,"
    } ]
  }, {
    "tStartMs": 70050,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "making sure that the\npark is well maintained."
    } ]
  }, {
    "tStartMs": 72150,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "[Emily] So generations to\ncome can visit this park"
    } ]
  }, {
    "tStartMs": 74340,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "and share the same wonder and\nexcitement that each of us do."
    } ]
  }, {
    "tStartMs": 79443,
    "dDurationMs": 2937,
    "segs": [ {
      "utf8": "(upbeat music)"
    } ]
  }, {
    "tStartMs": 82380,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "[Shasta] I try to cultivate\na very fun environment"
    } ]
  }, {
    "tStartMs": 85110,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because life doesn't have to\nbe serious all of the time."
    } ]
  }, {
    "tStartMs": 87480,
    "dDurationMs": 2608,
    "segs": [ {
      "utf8": "[Amya] Recreation-wise,\nI would probably say"
    } ]
  }, {
    "tStartMs": 90088,
    "dDurationMs": 1174,
    "segs": [ {
      "utf8": "whitewater rafting."
    } ]
  }, {
    "tStartMs": 91262,
    "dDurationMs": 1798,
    "segs": [ {
      "utf8": "That whole day was very, very fun."
    } ]
  }, {
    "tStartMs": 93060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "[Jayla] Sleeping under the stars"
    } ]
  }, {
    "tStartMs": 95100,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and putting up bear boxes with my friends."
    } ]
  }, {
    "tStartMs": 97950,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "[Esme] We did a dragonfly\nlarva collection day,"
    } ]
  }, {
    "tStartMs": 100110,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "and that was really fun."
    } ]
  }, {
    "tStartMs": 101640,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "[Nick] All the staff, all\nthe rangers that I met,"
    } ]
  }, {
    "tStartMs": 104190,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "just talking to them,"
    } ]
  }, {
    "tStartMs": 105060,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "they had this really\nincredible sense of stewardship"
    } ]
  }, {
    "tStartMs": 108090,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and love for what they\ndo and love for the land."
    } ]
  }, {
    "tStartMs": 111660,
    "dDurationMs": 2037,
    "segs": [ {
      "utf8": "[Stewart] I started out\nwith one of my friends,"
    } ]
  }, {
    "tStartMs": 113697,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "and we didn't really talk to anybody else,"
    } ]
  }, {
    "tStartMs": 115320,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "but as the summer progressed,"
    } ]
  }, {
    "tStartMs": 117180,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "we were able to get\ncloser with every person,"
    } ]
  }, {
    "tStartMs": 119130,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "everybody started talking more,"
    } ]
  }, {
    "tStartMs": 120810,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "and at the end, it was\nlike a miniature family."
    } ]
  }, {
    "tStartMs": 123733,
    "dDurationMs": 4937,
    "segs": [ {
      "utf8": "[Shasta] I see the youth\ngrowing exponentially in ways"
    } ]
  }, {
    "tStartMs": 128670,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that they didn't even think\nthat they were capable of."
    } ]
  }, {
    "tStartMs": 131460,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "[Adelynn] We live here in the\ntown where this fort stands."
    } ]
  }, {
    "tStartMs": 135420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "My opinion has changed in the way"
    } ]
  }, {
    "tStartMs": 138150,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "that I care more about it."
    } ]
  }, {
    "tStartMs": 139980,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "[Gracie] In general, I've grown\na lot just from being a YCC,"
    } ]
  }, {
    "tStartMs": 142710,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and then being a park ranger this year,"
    } ]
  }, {
    "tStartMs": 144870,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and also being a YCC just\ngets your foot in the door."
    } ]
  }, {
    "tStartMs": 147840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "[Shasta] It doesn't really\nmatter your background,"
    } ]
  }, {
    "tStartMs": 150240,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the skills that you gain from\nthe Youth Conservation Corps"
    } ]
  }, {
    "tStartMs": 153660,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "translate in any job."
    } ]
  }, {
    "tStartMs": 155850,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "[Fiona] This is what I wanna\ndo with the rest of my life."
    } ]
  }, {
    "tStartMs": 158040,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "It's so rewarding and so\namazing and incredible."
    } ]
  }, {
    "tStartMs": 163140,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "- [Members] Work, learn, play, and grow."
    } ]
  }, {
    "tStartMs": 168180,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Join the YCCC."
    } ]
  }, {
    "tStartMs": 170271,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "(waves rolling)"
    } ]
  } ]
}
