{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 4571,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "Taking their first steps outside\nfor their historic test flight."
    } ]
  }, {
    "tStartMs": 7974,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Four brave explorers\nready to ride the most powerful rocket."
    } ]
  }, {
    "tStartMs": 13113,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "NASA has ever launched."
    } ]
  }, {
    "tStartMs": 16016,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Reid, Victor, Christina and Jeremy."
    } ]
  }, {
    "tStartMs": 18852,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "We are going for our families."
    } ]
  }, {
    "tStartMs": 21354,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "We are going for our teammates."
    } ]
  }, {
    "tStartMs": 23156,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "We are going for all humanity."
    } ]
  }, {
    "tStartMs": 25225,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "Engines lit."
    } ]
  }, {
    "tStartMs": 26760,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "4. 3. "
    } ]
  }, {
    "tStartMs": 28828,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "2. 1."
    } ]
  }, {
    "tStartMs": 30597,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "Booster ignition."
    } ]
  }, {
    "tStartMs": 32065,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "And liftoff."
    } ]
  }, {
    "tStartMs": 33767,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The crew of Artemis II,\nnow bound for the Moon."
    } ]
  }, {
    "tStartMs": 38304,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "Houston. Integrity."
    } ]
  }, {
    "tStartMs": 39639,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "Great view."
    } ]
  }, {
    "tStartMs": 40874,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "This is a test flight,"
    } ]
  }, {
    "tStartMs": 41875,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "and so every single system\naboard Orion is getting tested"
    } ]
  }, {
    "tStartMs": 45678,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "by humans for the first time."
    } ]
  }, {
    "tStartMs": 47414,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "That is Earth in the center of your screen\nfrom the Orion spacecraft"
    } ]
  }, {
    "tStartMs": 51251,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "looking back at all of us."
    } ]
  }, {
    "tStartMs": 53119,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "Houston is go for TLI."
    } ]
  }, {
    "tStartMs": 55255,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "With this burn to the moon"
    } ]
  }, {
    "tStartMs": 57023,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "we do not leave Earth. We choose it."
    } ]
  }, {
    "tStartMs": 60460,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "The four of us have looked at this\nMoon our entire lives,"
    } ]
  }, {
    "tStartMs": 62796,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "and the way we are responding\nto what we are seeing out the window it's"
    } ]
  }, {
    "tStartMs": 65899,
    "dDurationMs": 3436,
    "segs": [ {
      "utf8": "just like we're a bunch of little kids up\nhere, just we cannot get enough of this."
    } ]
  }, {
    "tStartMs": 70937,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "That is something\nwe have never seen before."
    } ]
  }, {
    "tStartMs": 73206,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "It's hard to wrap your mind around, like,\nI mean that sincerely."
    } ]
  }, {
    "tStartMs": 76009,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "It really bends your mind."
    } ]
  }, {
    "tStartMs": 78411,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "As we prepare to go out of radio\ncommunication,"
    } ]
  }, {
    "tStartMs": 82315,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "to all of you down there on Earth"
    } ]
  }, {
    "tStartMs": 86019,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "and around Earth."
    } ]
  }, {
    "tStartMs": 87654,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "We love you from the Moon."
    } ]
  }, {
    "tStartMs": 91524,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "It just seems like,\nthere's mountains to the north."
    } ]
  }, {
    "tStartMs": 93927,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "You can see Copernicus, Reiner Gamma."
    } ]
  }, {
    "tStartMs": 96596,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "It's just everything from the training,\nbut in three dimension"
    } ]
  }, {
    "tStartMs": 100433,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and absolutely unbelievable."
    } ]
  }, {
    "tStartMs": 104437,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "Copy. Moon Joy."
    } ]
  }, {
    "tStartMs": 107207,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Superlative thumbs up."
    } ]
  }, {
    "tStartMs": 109876,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "This is"
    } ]
  }, {
    "tStartMs": 111311,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "We just went sci-fi."
    } ]
  }, {
    "tStartMs": 116850,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "I think there is enough for all,"
    } ]
  }, {
    "tStartMs": 118818,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "the purpose of humanity\nis joy and lifting"
    } ]
  }, {
    "tStartMs": 122489,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "one another up, creating together."
    } ]
  }, {
    "tStartMs": 124958,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "This is a whole bunch of nothing"
    } ]
  }, {
    "tStartMs": 126226,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "This thing we call the universe."
    } ]
  }, {
    "tStartMs": 127560,
    "dDurationMs": 4772,
    "segs": [ {
      "utf8": "You have this oasis, this beautiful place\nthat we get to exist together."
    } ]
  }, {
    "tStartMs": 134067,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "Well, I'll tell you."
    } ]
  }, {
    "tStartMs": 134968,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I mean, after ignition to me, the moment\nthat I'm going to be most excited"
    } ]
  }, {
    "tStartMs": 138538,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "for is splashdown,\nthere's no question about that."
    } ]
  }, {
    "tStartMs": 141508,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "Good chutes\ncoming down off the West Coast."
    } ]
  }, {
    "tStartMs": 155788,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "And there go the first series of parachutes."
    } ]
  }, {
    "tStartMs": 159659,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "Houston. We’re visual two drogues out the window."
    } ]
  }, {
    "tStartMs": 168001,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Main chute deploy."
    } ]
  }, {
    "tStartMs": 171337,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "We most importantly choose this moment"
    } ]
  }, {
    "tStartMs": 174040,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "to challenge this generation\nand in the next"
    } ]
  }, {
    "tStartMs": 177710,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "to make sure this\nrecord is not long lived."
    } ]
  }, {
    "tStartMs": 181548,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "This is a relay race."
    } ]
  }, {
    "tStartMs": 183283,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "It takes an army to pull a mission\ntogether like this,"
    } ]
  }, {
    "tStartMs": 186619,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "right, across all ten of our centers,\nall of our commercial partners,"
    } ]
  }, {
    "tStartMs": 190256,
    "dDurationMs": 3404,
    "segs": [ {
      "utf8": "the international partners\nthat come together make this possible."
    } ]
  }, {
    "tStartMs": 193660,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "Go Artemis!"
    } ]
  } ]
}
