    "segs": [ {
      "utf8": "in a new way with Roman"
    } ]
  }, {
    "tStartMs": 80029,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "for the first time."
    } ]
  }, {
    "tStartMs": 80947,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And we're just going to get blown away."
    } ]
  }, {
    "tStartMs": 83917,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "When we send Roman out there"
    } ]
  }, {
    "tStartMs": 85268,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "a million miles away."
    } ]
  }, {
    "tStartMs": 86269,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "It will take about three months"
    } ]
