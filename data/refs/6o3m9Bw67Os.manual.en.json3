      "utf8": "for a very long time."
    } ]
  }, {
    "tStartMs": 39322,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "One of them is about exoplanets"
    } ]
  }, {
    "tStartMs": 41591,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "and whether there are planets"
