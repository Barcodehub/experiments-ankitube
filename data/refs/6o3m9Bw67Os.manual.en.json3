      "utf8": "efficient observations"
    } ]
  }, {
    "tStartMs": 96713,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "as soon as we're there."
    } ]
  }, {
    "tStartMs": 97881,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "What new things will we discover that"
