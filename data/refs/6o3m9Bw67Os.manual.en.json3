  }, {
    "tStartMs": 43159,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "out there and solar systems out there"
    } ]
  }, {
    "tStartMs": 44994,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "like our own."
    } ]
  }, {
    "tStartMs": 46229,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "The other is about the biggest questions"
    } ]
  }, {
    "tStartMs": 48398,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "on the grandest scales,"
    } ]
  }, {
    "tStartMs": 49399,
    "dDurationMs": 1351,
    "segs": [ {
      "utf8": "the fabric of the universe,"
    } ]
  }, {
    "tStartMs": 50750,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "how the universe that we see around us"
    } ]
  }, {
    "tStartMs": 53069,
    "dDurationMs": 2119,
    "segs": [ {
      "utf8": "came to be... Pushed and pulled"
    } ]
  }, {
    "tStartMs": 55188,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "by the competing forces"
    } ]
  }, {
    "tStartMs": 56523,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "of dark matter and dark energy."
    } ]
  }, {
    "tStartMs": 58992,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "These are mysteries"
    } ]
  }, {
    "tStartMs": 59959,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "that Roman was designed to settle."
    } ]
  }, {
    "tStartMs": 61728,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "Three. Two. One."
    } ]
  }, {
