    "segs": [ {
      "utf8": "Roman Space Telescope!"
    } ]
  }, {
    "tStartMs": 75642,
    "dDurationMs": 1318,
    "segs": [ {
      "utf8": "We're going to open Roman's eyes,"
    } ]
  }, {
    "tStartMs": 76960,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "we're going to see the sky"
    } ]
  }, {
    "tStartMs": 78628,
