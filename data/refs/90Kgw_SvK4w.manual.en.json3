  "events": [ {
    "tStartMs": 1252,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "When it comes to Mars,"
    } ]
  }, {
    "tStartMs": 2753,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "everyone thought we were crazy."
    } ]
  }, {
    "tStartMs": 6339,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "But sometimes,"
    } ]
  }, {
    "tStartMs": 7924,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "that’s what it takes."
    } ]
  }, {
    "tStartMs": 10885,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "We're making science fiction"
    } ]
  }, {
    "tStartMs": 12803,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "reality."
    } ]
  }, {
    "tStartMs": 14638,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Writing the next chapters"
    } ]
  }, {
    "tStartMs": 16432,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "in the story"
    } ]
  }, {
    "tStartMs": 17391,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "of Mars exploration."
    } ]
  }, {
    "tStartMs": 20185,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "But it doesn't happen overnight."
    } ]
  }, {
    "tStartMs": 23062,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "Getting there is never easy."
    } ]
  }, {
    "tStartMs": 25565,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "[News Reporter] The first powered flight"
    } ]
  }, {
    "tStartMs": 26983,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "by an aircraft, on another planet."
    } ]
  }, {
    "tStartMs": 29693,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "It takes courage,"
    } ]
  }, {
    "tStartMs": 32154,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "creativity,"
    } ]
  }, {
    "tStartMs": 34406,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "resilience."
    } ]
  }, {
    "tStartMs": 36825,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "It takes a legacy of Daring Mighty Things."
    } ]
  }, {
    "tStartMs": 41370,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Of failing."
    } ]
  }, {
    "tStartMs": 47334,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "[Bruce Murray] Just a minute, listen."
    } ]
  }, {
    "tStartMs": 48168,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Hear me out."
    } ]
  }, {
    "tStartMs": 49211,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "And picking ourselves back up."
    } ]
  }, {
    "tStartMs": 52880,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "We've been here before."
    } ]
  }, {
    "tStartMs": 55174,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Decades of success."
    } ]
  }, {
    "tStartMs": 57885,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Building the future isn't for everyone."
    } ]
  }, {
    "tStartMs": 61555,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "But for us,"
    } ]
  }, {
    "tStartMs": 62514,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "it's written in our DNA."
    } ]
  }, {
    "tStartMs": 64182,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "We are the architects of the impossible."
    } ]
  }, {
    "tStartMs": 68478,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "And on Mars,"
    } ]
  }, {
    "tStartMs": 71105,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "we've only just begun."
    } ]
  } ]
}
