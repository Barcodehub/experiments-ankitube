    } ]
  }, {
    "tStartMs": 24024,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "our ocean is bursting with life."
    } ]
  }, {
    "tStartMs": 28028,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "And it gives life,"
